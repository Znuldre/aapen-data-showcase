{
  "name": "@showcase/mobilitetsatlas-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "kopier-worker": "node -e \"require('fs').copyFileSync(require.resolve('maplibre-gl/dist/maplibre-gl-worker.mjs'), 'public/maplibre-gl-worker.mjs')\"",
    "predev": "npm run kopier-worker",
    "dev": "vite",
    "prebuild": "npm run kopier-worker",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "publiser": "node scripts/publiser.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@showcase/shared": "^0.1.0",
    "maplibre-gl": "^6.15.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

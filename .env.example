# Entur krever identifikasjon i alle kall, på formen <organisasjon>-<applikasjon>
ENTUR_CLIENT_NAME=minorganisasjon-aapendata-showcase

# MET og Wikimedia krever en User-Agent med kontaktinfo (URL eller e-post)
MET_USER_AGENT=aapendata-showcase/0.1 (+https://example.org/kontakt)
WIKIMEDIA_USER_AGENT=aapendata-showcase/0.1 (+https://example.org/kontakt)

# Java-installasjonen r5py skal bruke (tom = finn automatisk)
JAVA_HOME=
